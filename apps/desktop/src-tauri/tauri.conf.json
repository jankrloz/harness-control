{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harness-control",
  "version": "0.2.0",
  "identifier": "dev.harness-control.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @harness-control/web dev",
    "devUrl": "http://127.0.0.1:4319",
    "beforeBuildCommand": "pnpm --filter @harness-control/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "harness-control",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4318 http://localhost:4318; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
